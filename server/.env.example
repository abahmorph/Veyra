# Copy to server/.env and adjust.

PORT=8787
NODE_ENV=development

# Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_SECONDS=1209600

# DB_DRIVER=sqlite uses node:sqlite at DB_PATH (zero-config local).
# DB_DRIVER=postgres uses DATABASE_URL; apply server/migrations/001_init.sql first.
DB_DRIVER=sqlite
DB_PATH=../data/veyra.sqlite
# DATABASE_URL=postgres://user:pass@localhost:5432/veyra

# ---- Bank transfer details (shown on the Premium screen) ----
# Filled into the payment_settings row on first boot; editable later from
# the Admin panel. Values here only apply when the row is still empty.
VEYRA_BANK_NAME=
VEYRA_BANK_ACCOUNT_NAME=
VEYRA_BANK_ACCOUNT_NUMBER=
VEYRA_BANK_INSTRUCTIONS=
VEYRA_CURRENCY=NGN

# ---- Admin account ----
# On boot the server creates this administrator only if none exists yet.
VEYRA_ADMIN_EMAIL=
VEYRA_ADMIN_PASSWORD=
VEYRA_ADMIN_NAME=Administrator
# One-time token authorising POST /api/admin/bootstrap.
# VEYRA_ADMIN_BOOTSTRAP_TOKEN=

# Pricing (server is the source of truth; the desktop mirrors these).
VEYRA_PRICE_MONTHLY=6000
VEYRA_PRICE_YEARLY=60000
